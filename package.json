    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-angular": "22.0.0",
    "express": "5.2.1",
    "inter-ui": "4.1.1",
    "maplibre-gl": "6.12.0",
    "marked": "18.0.14",
    "ng-primitives": "0.131.2",
