{
  "name": "elbe-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "pnpm sitemap && pnpm markdown:highlight && ng build",
    "build:pages": "pnpm sitemap && pnpm markdown:highlight && ng build && cp dist/elbeui/browser/index.html dist/elbeui/browser/404.html",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:elbeui": "node dist/elbeui/server/server.mjs",
    "fmt": "prettier --write .",
    "sitemap": "tsx tools/sitemap.ts",
    "markdown:highlight": "tsx tools/markdown-highlight.ts",
    "og": "tsx tools/og.ts"
  },
  "packageManager": "pnpm@11.22.0",
