    "@types/geojson": "7946.0.16",
    "@types/node": "22.19.2",
    "jsdom": "27.4.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sitemap": "9.0.1",
